# Where Next rewrites /api/* to (server-side only; the browser never sees it).
# Also used by server components (e.g. /toilets/[id]) to fetch the API directly.
API_ORIGIN=http://localhost:4000

# Show the email-only dev login form on /login (pairs with DEV_LOGIN_ENABLED=true on the API).
# Leave unset or false in production.
NEXT_PUBLIC_DEV_LOGIN=true

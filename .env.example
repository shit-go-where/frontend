# Where Next rewrites /api/* to (server-side only; the browser never sees it).
# Also used by server components (e.g. /toilets/[id]) to fetch the API directly.
API_ORIGIN=http://localhost:4000

# Public origin for canonical URLs, sitemap.xml and robots.txt. Defaults to Vercel's production
# domain, then http://localhost:3000. Set it once a custom domain is live.
# NEXT_PUBLIC_SITE_URL=https://shitgowhere.sg

# Public contact address on /about and /privacy (e.g. a Cloudflare Email Routing alias that forwards
# to your inbox). Inlined at build time, so redeploy after changing it. Unset hides the email lines.
# NEXT_PUBLIC_CONTACT_EMAIL=hello@shitgowhere.sg

# Show the email-only dev login form on /login (pairs with DEV_LOGIN_ENABLED=true on the API).
# Leave unset or false in production.
NEXT_PUBLIC_DEV_LOGIN=true

# Where Next rewrites /api/* to (server-side only; the browser never sees it).
# Also used by server components (e.g. /toilets/[id]) to fetch the API directly.
# REQUIRED in production: there is no build error if it is missing, it silently falls back to localhost.
API_ORIGIN=http://localhost:4000

# Shared secret with the API (same value as its API_PROXY_SECRET). When set, proxy.ts forwards each
# visitor's IP to the API with it, so rate limits are per phone instead of per Vercel proxy. Server-side
# only. Leave empty locally.
# API_PROXY_SECRET=

# Public origin for canonical URLs, sitemap.xml and robots.txt. Defaults to Vercel's production
# domain, then http://localhost:3000. Set it once a custom domain is live.
# NEXT_PUBLIC_SITE_URL=https://shitgowhere.com

# Public contact address on /about and /privacy (e.g. a Cloudflare Email Routing alias that forwards
# to your inbox). Inlined at build time, so redeploy after changing it. Unset hides the email lines.
# NEXT_PUBLIC_CONTACT_EMAIL=hello@shitgowhere.com

# The Telegram bot linked from /about, the map sheet and a few tips. Defaults to the live bot; "off" hides
# every mention, another t.me link points them at a test bot. Inlined at build time.
# NEXT_PUBLIC_TELEGRAM_BOT_URL=https://t.me/ShitGoWhereBot

# PostHog US project key for product analytics (GROWTH.md 0.1). Unset = analytics off: nothing loads or is
# sent, which is what local dev and the e2e suite want. Requests go through the /ingest rewrite in next.config.ts.
# NEXT_PUBLIC_POSTHOG_KEY=phc_...

# Sentry error reporting (README, Error reporting). Unset = off: the SDK never loads and nothing is sent,
# which is what local dev and the e2e suite want. Browser reports go through the /monitoring tunnel.
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@o<org>.ingest.us.sentry.io/<project>
# Source map upload at build time, Vercel only. Without SENTRY_AUTH_TOKEN no source maps are built or
# uploaded and the build is unchanged. Never put the token in this file or in a NEXT_PUBLIC_ variable.
# SENTRY_ORG=shit-go-where
# SENTRY_PROJECT=sgw-frontend
# SENTRY_AUTH_TOKEN=

# Show the email-only dev login form on /login (pairs with DEV_LOGIN_ENABLED=true on the API).
# Leave unset or false in production (this file is for local use; Vercel does not read it).
# NEXT_PUBLIC_* values are baked into the browser bundle: never put a secret in one.
NEXT_PUBLIC_DEV_LOGIN=true
